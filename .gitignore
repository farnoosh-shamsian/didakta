# --- Secrets: never commit ---
.env
*.env
!.env.example

# --- Python virtual environment (1.3 GB, regenerable) ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Editor settings ---
.vscode/
.idea/
.DS_Store

# --- Experiments: kept local only ---
experiments/

# --- Trained models / large binaries (exceed GitHub's 100 MB file limit) ---
*.joblib
*.safetensors
*.bin
*.pt
*.ckpt
*.h5

# --- Local build/cleanup scripts: kept out of the published repo ---
scripts/

# --- Annotation ---
# annotation/ is tracked: per work, the annotated treebank, its prompt, and the texts, translations,
# commentaries and treebanks the prompt uses. The scans, full LSJ, scripts and build files are local,
# in provenance/annotation/ (ignored below).

# --- Claude Code local settings ---
.claude/

# --- Provenance: how data/ was built (scripts, source spreadsheets, reports). Local only ---
provenance/
