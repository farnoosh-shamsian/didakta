# --- Secrets: never commit ---
.env
*.env
!.env.example

# --- Python virtual environment (1.3 GB, regenerable) ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Editor settings ---
.vscode/
.idea/
.DS_Store

# --- Experiments: kept local only ---
experiments/

# --- Trained models / large binaries (exceed GitHub's 100 MB file limit) ---
*.joblib
*.safetensors
*.bin
*.pt
*.ckpt
*.h5

# --- Local build/cleanup scripts: kept out of the published repo ---
scripts/

# --- Annotation experiments: downloaded sources (~1.9 GB) stay local ---
# READMEs, manifests, derived data and tools are tracked; tools/fetch2.py rebuilds sources.
annotattion-experiments/*/sources/
# 88 MB, over GitHub's 50 MB warning; tools/lsj_subset.py rebuilds it
annotattion-experiments/reference/derived/lsj-cyropaedia-anabasis/lsj-subset.jsonl
# Rebuildable annotation context (~140 MB): tools/build_base.py and tools/build_bundles.py regenerate them
annotattion-experiments/*/annotation/base-sentences.jsonl
annotattion-experiments/*/annotation/sentences.jsonl
