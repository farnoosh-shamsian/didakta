# --- Secrets: never commit ---
.env
*.env
!.env.example

# --- Python virtual environment (1.3 GB, regenerable) ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Editor settings ---
.vscode/
.idea/
.DS_Store

# --- Experiments: kept local only ---
experiments/

# --- Trained models / large binaries (exceed GitHub's 100 MB file limit) ---
*.joblib
*.safetensors
*.bin
*.pt
*.ckpt
*.h5

# --- Local build/cleanup scripts: kept out of the published repo ---
scripts/

# --- Annotation: downloaded sources (~2.5 GB) stay local ---
# Tracked: prompts, annotation output, aligned translations, tag cards, READMEs, manifests, tools.
# annotation-support/tools/fetch2.py + layout.py rebuild the rest. Downloaded files are named <kind>-<slug>.<ext>.
annotation-experiments/*/not-machine-readable/
annotation-experiments/*/sources/
annotation-experiments/*/greek-text-*
annotation-experiments/*/translation-*
annotation-experiments/*/treebank-*
annotation-experiments/*/commentary-*
annotation-experiments/*/grammar-*
annotation-experiments/*/lexicon-*
annotation-experiments/*/language-study-*
annotation-support/*/background/
annotation-support/*/raw-downloads/
# LSJ subsets (88 and 91 MB, over GitHub's 50 MB warning); lsj_subset.py rebuilds them
annotation-experiments/*/lsj-*.jsonl
# Rebuildable (~115 MB): build_base.py and build_bundles.py regenerate them
annotation-experiments/*/sentences.jsonl
annotation-support/*/base-sentences.jsonl

# --- Provenance: how data/ was built (scripts, source spreadsheets, reports). Local only ---
provenance/
